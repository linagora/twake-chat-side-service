{
  "name": "twake-chat-side-service",
  "version": "0.1.0",
  "description": "Matrix application service of Twake Chat that issues the call tokens through Meet, relays the assistants to twake-harness and serves the public pages of the rooms open to all",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "start": "node --import ./dist/instrument.js dist/main.js"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.7.2",
    "@linagora/twake-css": "^1.0.0",
    "@linagora/twake-node-telemetry": "^1.2.0",
    "@sentry/node": "^11.9.0",
    "fastify": "^5.12.7",
    "ldapts": "^9.2.0",
    "markdown-it": "^15.0.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
